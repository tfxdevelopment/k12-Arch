+++ b/apps/K12.QueryBuilder.Gateway/Dockerfile
@@ -1,7 +1,11 @@
 # See https://aka.ms/customizecontainer
 # Multi-stage build for K12.QueryBuilder.Gateway (YARP reverse proxy)
 
-FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
+# K12-8804: Ubuntu chiseled runtime image. The final layer has no shell/apt/perl/util-linux/pam/
+# ncurses/coreutils, which removes most of the OS packages Defender flagged; glibc, openssl, ICU and
+# tzdata remain (-extra keeps ICU + tzdata), so the image still needs regular rebuilds on a current
+# base. Rebuilding also pulls the current .NET 10 runtime (>= 10.0.11).
+FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled-extra AS base
 USER $APP_UID
 WORKDIR /app
 EXPOSE 8080

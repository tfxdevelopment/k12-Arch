        {
          &quot;id&quot;: &quot;v-abc123&quot;,
          &quot;template_id&quot;: &quot;d-abc123def456ghi789&quot;,
          &quot;active&quot;: 1,
          &quot;name&quot;: &quot;Application Approval v2&quot;,

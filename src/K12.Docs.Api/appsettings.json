{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Dapr": "Information"
    }
  },
  "AllowedHosts": "*",
  "Aspire": {
    "ServiceDefaults": {
      "EnableHealthChecks": true,
      "EnableOpenTelemetry": true,
      "EnableServiceDiscovery": true
    }
  },
  "Dapr": {
    "AppId": "docs-api",
    "AppPort": 5000,
    "HttpPort": 3500,
    "GrpcPort": 50001
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "Documentation": {
    "WikiPath": "../../wiki",
    "EnableMarkdownRendering": true,
    "EnableFrontmatterParsing": true,
    "CacheExpirationMinutes": 30
  },
  "OpenApi": {
    "Title": "K12 Architecture Documentation API",
    "Version": "v1",
    "Description": "API for serving K12 architecture documentation and metadata"
  }
}

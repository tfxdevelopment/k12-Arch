{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting": "Information",
      "Dapr": "Information"
    }
  },
  "Aspire": {
    "Dashboard": {
      "EnableMetrics": true,
      "EnableTracing": true,
      "EnableLogs": true
    }
  },
  "Dapr": {
    "GrpcPort": 50001,
    "HttpPort": 3500,
    "EnableTelemetry": true,
    "EnableMtls": false,
    "LogLevel": "info"
  },
  "APIM": {
    "HttpPort": 8080,
    "ConfigPath": "./apim-config"
  },
  "Services": {
    "DocsApi": {
      "Port": 5000,
      "EnableSwagger": true
    },
    "DocsSite": {
      "Port": 4200
    }
  }
}

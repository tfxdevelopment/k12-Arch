<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Official NuGet feed -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

    <!-- .NET 10 Preview feed (required for preview packages) -->
    <add key="dotnet-preview" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet10/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <!-- Map .NET and Aspire preview packages to preview feed -->
    <packageSource key="dotnet-preview">
      <package pattern="Microsoft.*" />
      <package pattern="Aspire.*" />
      <package pattern="System.*" />
    </packageSource>

    <!-- Map all other packages to nuget.org -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
